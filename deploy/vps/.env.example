# Copy to .env (add-client.sh creates it automatically on first run).
# Shared password for the Postgres engine. Generate a strong one:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# ── Off-site backups (optional, but strongly recommended) ────────────────────
# Without these, backup.sh writes only to ./backups/ on this same server — so
# losing the server loses every society's records with it.
#
# Works with any S3-compatible store (DigitalOcean Spaces, Backblaze B2, AWS).
# The bucket MUST be private: these dumps hold members' names, savings and loans.
# Set retention on the bucket itself, so a compromised server cannot delete its
# own backup history.
#
# OFFSITE_BUCKET=coopms-backups
# OFFSITE_ENDPOINT=https://fra1.digitaloceanspaces.com
# OFFSITE_REGION=fra1
# OFFSITE_PREFIX=vps1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Encrypt each dump before it leaves the server. Keep this passphrase somewhere
# other than this server — without it the backups cannot be restored.
# BACKUP_PASSPHRASE=

# How many days of dumps to keep on the server itself (default 14).
# BACKUP_RETAIN_DAYS=14
