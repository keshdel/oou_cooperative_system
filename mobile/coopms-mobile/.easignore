# What NOT to send to EAS Build.
#
# NOTE: this file alone did not work. EAS archived the whole repository anyway.
# The root .gitignore is what actually excludes the heavy directories — see the
# "Kept out of the EAS build archive" section there. This file is kept because
# it is the documented mechanism and costs nothing, but do not rely on it.
#
# ── The Flask server project ──────────────────────────────────────────────────
/blueprints/
/templates/
/static/
/deploy/
/docs/
/tests/
/migrations/
/scripts/
/functions/
/cards/
/test_data/
/uploads/
/logs/
/backups/
/Backup/
/outputs/
/__pycache__/
*.py
*.pyc
requirements.txt
Dockerfile*
docker-compose*.yml
Procfile
render.yaml
runtime.txt
nginx.conf

# ── Databases, dumps and local junk ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log
*.pptx
*.csv
/ssl/
/venv/
/.venv/
/.claude/
/.codex/
/node_modules/

# ── Inside the app itself ─────────────────────────────────────────────────────
mobile/coopms-mobile/node_modules/
mobile/coopms-mobile/.expo/
mobile/coopms-mobile/dist/
node_modules/
.expo/
dist/
