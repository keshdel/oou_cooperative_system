{
  "expo": {
    "name": "CoopMS",
    "slug": "coopms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coopms",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "primaryColor": "#0B3475",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#083574",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cooperativems.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cooperativems.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3475"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://ooucoop.cooperativems.com",
      "eas": {
        "projectId": "1af475a1-aea5-42ad-939b-b1b64f8492e5"
      }
    }
  }
}
